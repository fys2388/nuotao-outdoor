// Alloy Configuration for Nuotao AI OS
// /etc/alloy/config.alloy

loki.source.file "nuotao_backend" {
  targets    = [
    "/var/log/nuotao/*.log",
    "/var/log/syslog",
    "/var/log/auth.log",
  ]
  forward_to = loki.write.default.receiver
}

loki.source.syslog "syslog" {
  listen_address  = ":1514"
  listen_protocol = "udp"
  forward_to      = loki.write.default.receiver
}

loki.write "default" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}