[Unit]
Description=Nuotao AI OS Backend API Server (Staging)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=nuotao
Group=nuotao
WorkingDirectory=/opt/nuotao/staging/backend
Environment="PATH=/opt/nuotao/staging/backend/.venv/bin"
EnvironmentFile=/opt/nuotao/staging/.env
ExecStart=/opt/nuotao/staging/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nuotao-backend-staging

# 安全限制
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nuotao/staging/backend/data /opt/nuotao/staging/backend/logs

[Install]
WantedBy=multi-user.target
