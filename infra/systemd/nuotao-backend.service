[Unit]
Description=Nuotao AI OS Backend API Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=nuotao
Group=nuotao
WorkingDirectory=/opt/nuotao-ai-os/backend
Environment="PATH=/opt/nuotao-ai-os/backend/.venv/bin"
# playwright 浏览器目录必须在 uvicorn 进程环境里可见（单元级，不依赖 .env）
Environment="PLAYWRIGHT_BROWSERS_PATH=/home/nuotao/.cache/ms-playwright"
EnvironmentFile=/opt/nuotao-ai-os/backend/.env
ExecStart=/opt/nuotao-ai-os/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nuotao-backend

# 安全限制
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# uvicorn 需要读 playwright 浏览器缓存（/home/nuotao/.cache/ms-playwright）；
# ProtectHome=true 会把 /home 整体隔离，导致 DynamicFetcher 报
# "Executable doesn't exist at /home/nuotao/.cache/ms-playwright/chromium-*/chrome-linux64/chrome"。
# read-only + 显式 ReadWritePaths 才能既保安全又让浏览器起得来。
ProtectHome=read-only
ReadWritePaths=/opt/nuotao-ai-os/backend/data /opt/nuotao-ai-os/backend/logs /opt/nuotao-ai-os/backend/app/data /opt/nuotao-ai-os/backend/app/logs /home/nuotao/.cache
ReadWritePaths+=/home/nuotao/.camoufox /tmp

[Install]
WantedBy=multi-user.target
