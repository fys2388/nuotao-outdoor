# Production build: the B2B portal is served as a static SPA on Cloudflare
# Pages, where there is no /api backend. Point the API clients at the public
# backend on the console origin (nginx proxies /api/* to FastAPI).
VITE_B2B_SHOWCASE_API=https://admin.nuotaooutdoor.com/api/v1/b2b-showcase
VITE_B2B_PORTAL_API=https://admin.nuotaooutdoor.com/api/v1/b2b-portal
