# ============================================
# Nuotao AI OS - 生产环境配置 (Production)
# ============================================
# 用途：正式生产环境、真实业务数据
# 特点：最高安全、严格成本限制、日志WARNING、数据加密
# 注意：所有 CHANGE_ME 必须替换为真实值，密钥使用 Secrets 管理
# ============================================

# --- 应用 ---
APP_NAME=Nuotao AI OS
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# --- 数据库（生产） ---
DATABASE_URL=postgresql+asyncpg://nuotao_prod:CHANGE_ME_VERY_STRONG_PASSWORD@prod-db.internal:5432/nuotao_prod
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=50
DATABASE_SSL_MODE=require

# --- Redis（生产） ---
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@prod-redis.internal:6379/0
CACHE_ENABLED=true
CACHE_MAX_CONNECTIONS=50
CACHE_DEFAULT_TTL=300

# --- API ---
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://nuotaooutdoor.com,https://www.nuotaooutdoor.com

# --- WooCommerce（生产） ---
WOOCOMMERCE_BASE_URL=https://nuotaooutdoor.com
WOOCOMMERCE_CONSUMER_KEY=ck_CHANGE_ME_PRODUCTION
WOOCOMMERCE_CONSUMER_SECRET=cs_CHANGE_ME_PRODUCTION
WOOCOMMERCE_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_WEBHOOK_SECRET

# --- JWT / 认证（生产） ---
JWT_SECRET_KEY=CHANGE_ME_VERY_STRONG_RANDOM_KEY_AT_LEAST_64_CHARS_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / AI Agent（生产成本限制） ---
LLM_PROVIDER=deepseek
LLM_API_KEY=sk_CHANGE_ME_PRODUCTION
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
AGENT_MONTHLY_BUDGET_USD=50.00
AGENT_MAX_COST_PER_EXECUTION=2.00

# --- 飞书通知（生产） ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME_PRODUCTION
FEISHU_NOTIFICATIONS_ENABLED=true

# --- 邮件（生产） ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=prod@nuotao.com
SMTP_PASSWORD=CHANGE_ME_PRODUCTION
SMTP_FROM_EMAIL=noreply@nuotaooutdoor.com

# --- 支付（生产真实模式） ---
PAYMENT_PROVIDER=woocommerce
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
PAYPAL_CLIENT_ID=live-CHANGE_ME
PAYPAL_CLIENT_SECRET=live-CHANGE_ME

# --- 物流（生产） ---
LOGISTICS_PROVIDER=manual
LOGISTICS_API_KEY=CHANGE_ME_PRODUCTION

# --- 备份（生产） ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 1 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_STORAGE_PATH=/var/backups/nuotao/database
BACKUP_UPLOAD_TO_S3=true
BACKUP_S3_BUCKET=nuotao-prod-backups
BACKUP_S3_REGION=ap-southeast-1

# --- 监控（生产） ---
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=30
ALERT_CPU_THRESHOLD=75
ALERT_MEMORY_THRESHOLD=75
ALERT_DISK_THRESHOLD=80

# --- 安全（生产最高） ---
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
SECURITY_HEADERS_ENABLED=true
PII_ENCRYPTION_ENABLED=true

# --- 前端（生产） ---
FRONTEND_URL=https://nuotaooutdoor.com
FRONTEND_BUILD_PATH=/var/www/nuotao/frontend/dist
