    {"id": "EDGE-001", "description": "零成本价产品", "input": {"cost_price": 0}, "expected_behavior": "标记数据异常，拒绝评分"},
    {"id": "EDGE-002", "description": "超高零售价（10倍成本）", "input": {"cost_price": 10, "retail_price": 1000}, "expected_behavior": "标记定价异常，需人工审核"},
    {"id": "EDGE-003", "description": "缺失关键字段", "input": {"name": "测试产品"}, "expected_behavior": "返回字段缺失错误，不进行评分"},
    {"id": "EDGE-004", "description": "超大件产品（>20kg）", "input": {"weight": 25}, "expected_behavior": "物流评分极低，建议拒绝"},
    {"id": "EDGE-005", "description": "新供应商（<1年）+ 高风险品类", "input": {"supplier_years": 0, "hazardous": true}, "expected_behavior": "风险评分极高，建议拒绝或深度审核"}
  ],
  "evaluation_protocol": {
    "steps": [
      "1. 加载测试集，逐条输入到选品决策模型",
      "2. 记录模型输出的 decision、score、key_factors、risk_flags",
      "3. 与 expected 对比，计算各维度准确率",
      "4. 计算综合得分（decision_match * 40 + score_accuracy * 30 + factor_match * 20 + risk_match * 10）",
      "5. 生成评测报告，包含错误案例分析和改进建议"
    ],
    "decision_match_weights": {"approve": 1.0, "approve_with_caution": 0.8, "pending_review": 0.6, "reject": 1.0}
  }
}
