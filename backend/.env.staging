# ============================================
# Nuotao AI OS - 预发布环境配置 (Staging)
# ============================================
# 用途：上线前测试、UAT验收、集成测试
# 特点：接近生产配置、数据隔离、成本限制、日志INFO
# ============================================

# --- 应用 ---
APP_NAME=Nuotao AI OS (Staging)
APP_VERSION=0.1.0
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://nuotao_staging:CHANGE_ME_STRONG_PASSWORD@staging-db.internal:5432/nuotao_staging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# --- Redis ---
REDIS_URL=redis://staging-redis.internal:6379/1
CACHE_ENABLED=true
CACHE_MAX_CONNECTIONS=20
CACHE_DEFAULT_TTL=300

# --- API ---
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://staging.nuotaooutdoor.com

# --- WooCommerce ---
WOOCOMMERCE_BASE_URL=https://staging.nuotaooutdoor.com
WOOCOMMERCE_CONSUMER_KEY=ck_CHANGE_ME_STAGING
WOOCOMMERCE_CONSUMER_SECRET=cs_CHANGE_ME_STAGING
WOOCOMMERCE_WEBHOOK_SECRET=CHANGE_ME_STAGING_WEBHOOK_SECRET

# --- JWT / 认证 ---
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_KEY_AT_LEAST_64_CHARS_STAGING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / AI Agent ---
LLM_PROVIDER=deepseek
LLM_API_KEY=sk_CHANGE_ME_STAGING
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
AGENT_MONTHLY_BUDGET_USD=20.00
AGENT_MAX_COST_PER_EXECUTION=1.00

# --- 飞书通知 ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME_STAGING
FEISHU_NOTIFICATIONS_ENABLED=true

# --- 邮件 ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=staging@nuotao.com
SMTP_PASSWORD=CHANGE_ME_STAGING
SMTP_FROM_EMAIL=staging@nuotaooutdoor.com

# --- 支付（测试模式） ---
PAYMENT_PROVIDER=woocommerce
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
PAYPAL_CLIENT_ID=test-CHANGE_ME
PAYPAL_CLIENT_SECRET=test-CHANGE_ME

# --- 物流 ---
LOGISTICS_PROVIDER=manual
LOGISTICS_API_KEY=CHANGE_ME_STAGING

# --- 备份 ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_PATH=/var/backups/nuotao/database

# --- 监控 ---
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=60
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=80
ALERT_DISK_THRESHOLD=85

# --- 安全 ---
PASSWORD_MIN_LENGTH=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# --- 前端 ---
FRONTEND_URL=https://staging.nuotaooutdoor.com
FRONTEND_BUILD_PATH=/var/www/nuotao/frontend/dist
