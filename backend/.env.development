# ============================================
# Nuotao AI OS - 开发环境配置 (Development)
# ============================================
# 用途：本地开发、调试、单元测试
# 特点：调试模式开启、日志详细、无成本限制、数据可重置
# ============================================

# --- 应用 ---
APP_NAME=Nuotao AI OS (Dev)
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://nuotao:nuotao_dev_password@localhost:5432/nuotao
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_MAX_CONNECTIONS=10
CACHE_DEFAULT_TTL=60

# --- API ---
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- WooCommerce ---
WOOCOMMERCE_BASE_URL=https://nuotaooutdoor.com
WOOCOMMERCE_CONSUMER_KEY=ck_483264900d40e98874a3415aabde3b9493e236ed
WOOCOMMERCE_CONSUMER_SECRET=cs_0e6ba22a04376077c3c8d96c06b795b1b07dc24c
WOOCOMMERCE_WEBHOOK_SECRET=VSgwAnYjJstBRPiCz67kqcmfu9GrTy84

# --- JWT / 认证 ---
JWT_SECRET_KEY=nuotao-ai-os-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / AI Agent ---
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
AGENT_MONTHLY_BUDGET_USD=100.00
AGENT_MAX_COST_PER_EXECUTION=5.00

# --- 飞书通知 ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/1035e5f2-8984-44d1-83f4-9fb60f274371
FEISHU_NOTIFICATIONS_ENABLED=true

# --- 邮件 ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dev@nuotao.com
SMTP_PASSWORD=dev-password
SMTP_FROM_EMAIL=dev@nuotaooutdoor.com

# --- 支付 ---
PAYMENT_PROVIDER=woocommerce
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
PAYPAL_CLIENT_ID=test-client-id
PAYPAL_CLIENT_SECRET=test-secret

# --- 物流 ---
LOGISTICS_PROVIDER=manual
LOGISTICS_API_KEY=dev-logistics-key

# --- 备份 ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=E:/AI/nuotao-ai-os/backups/database

# --- 监控 ---
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=60
ALERT_CPU_THRESHOLD=85
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90

# --- 安全 ---
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# --- 前端 ---
FRONTEND_URL=http://localhost:3000
FRONTEND_BUILD_PATH=../frontend/dist
