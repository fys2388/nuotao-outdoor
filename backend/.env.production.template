# ============================================================
# Nuotao AI OS - Production Environment Template
# 复制为 .env 并填入实际值; 敏感值不可提交仓库
# ============================================================

# --- App ---
APP_ENV=production
APP_NAME=Nuotao AI OS
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEFAULT_WORKSPACE_ID=default

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nuotao:CHANGE_ME@127.0.0.1:5432/nuotao
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nuotao
DB_USER=nuotao
DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Security ---
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- Cache ---
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# --- i18n ---
I18N_DEFAULT_LANGUAGE=en
I18N_SUPPORTED_LANGUAGES=["en","zh"]
I18N_AUTO_DETECT=true
I18N_COOKIE_NAME=lang
CURRENCY_COOKIE_NAME=currency
DEFAULT_CURRENCY=USD
MULTI_CURRENCY_ENABLED=true
SUPPORTED_CURRENCIES=["USD","EUR","CNY"]

# --- LLM ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
LLM_FALLBACK_PROVIDER=

# --- WooCommerce ---
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_STORE_ID=
WOOCOMMERCE_STORE_NAME=
WOOCOMMERCE_DEFAULT_STORE=
WOOCOMMERCE_STORES=[]
WOOCOMMERCE_WEBHOOK_SECRET=

# --- 1688 / Alibaba ---
ALI1688_APP_KEY=
ALI1688_APP_SECRET=
ALI1688_ACCESS_TOKEN=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=alerts@nuotaooutdoor.com
FROM_NAME=Nuotao AI OS

# --- Feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_CALLBACK_BASE_URL=

# --- Tracking ---
TRACKING_DEFAULT_PROVIDER=17track
TRACKING_17TRACK_API_KEY=
TRACKING_17TRACK_BASE_URL=https://api.17track.net
TRACKING_AFTERSHIP_API_KEY=
TRACKING_AFTERSHIP_BASE_URL=https://api.aftership.com
TRACKING_UPDATE_INTERVAL=3600

# --- Ads ---
ADS_SYNC_INTERVAL=3600
ADS_FACEBOOK_ACCESS_TOKEN=
ADS_FACEBOOK_AD_ACCOUNT_ID=
ADS_FACEBOOK_API_VERSION=v18.0
ADS_GOOGLE_DEVELOPER_TOKEN=
ADS_GOOGLE_CLIENT_CUSTOMER_ID=
ADS_GOOGLE_REFRESH_TOKEN=

# --- Ecommerce integrations ---
ECOMMERCE_AMAZON_SELLER_ID=
ECOMMERCE_AMAZON_MWS_AUTH_TOKEN=
ECOMMERCE_AMAZON_MARKETPLACE_ID=
ECOMMERCE_EBAY_APP_ID=
ECOMMERCE_EBAY_CERT_ID=
ECOMMERCE_EBAY_REFRESH_TOKEN=

# --- Backup ---
BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/nuotao
BACKUP_RETENTION_DAYS=30

# --- Monitor ---
MONITOR_ENABLED=true
MONITOR_DATA_DIR=/opt/nuotao/backend/data/monitor
MONITOR_INTERVAL=60
