        }
      },
      "expected": {
        "output_keys": [
          "insight"
        ],
        "rules": [
          {
            "type": "key_exists",
            "key": "insight"
          },
          {
            "type": "forbidden_text",
            "key": "insight",
            "values": [
              "{{",
              "unknown reason",
              "原因不明"
            ]
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "毛利 31%→12% 必须给出可验证归因"
