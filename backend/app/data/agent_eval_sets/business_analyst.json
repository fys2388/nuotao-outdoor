{
  "agent_id": "business_analyst",
  "description": "商业分析师 Agent 评测集：报告完整性、指标合法性、PII 保护（确定性用例）",
  "cases": [
    {
      "id": "ba-001",
      "category": "report_completeness",
      "title": "周报缺收入指标拦截",
      "eval_mode": "deterministic",
      "input": {
        "report": {
          "week": "2026-W36",
          "orders": 120,
          "refund_rate": 0.02
        }
      },
      "expected": {
        "output_keys": [
          "is_complete",
          "missing"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "is_complete",
            "value": false
          },
          {
            "type": "truthy",
            "key": "missing"
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "收入为必填指标"
    },
    {
      "id": "ba-002",
      "category": "report_completeness",
      "title": "完整周报应通过",
      "eval_mode": "deterministic",
