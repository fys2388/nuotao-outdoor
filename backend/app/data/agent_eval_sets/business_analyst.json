          "refund_rate": 0.02,
          "ad_spend": 2800,
          "roas": 4.46,
          "data_sources": [
            "woocommerce",
            "ga4"
          ]
        }
      },
      "expected": {
        "output_keys": [
          "is_complete"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "is_complete",
            "value": true
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "7 项核心指标齐全"
    },
