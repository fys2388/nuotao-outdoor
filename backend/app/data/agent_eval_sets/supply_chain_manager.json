  "cases": [
    {"id": "sc-001", "category": "restock_margin", "title": "补货成本高于售价判亏损", "eval_mode": "deterministic", "input": {"revenue": "35.00", "product_cost": "22.00", "shipping_cost": "12.00", "payment_fee": "1.05"}, "expected": {"output_keys": ["contribution_margin"], "rules": [{"type": "value_lt", "key": "contribution_margin", "value": 0}]}, "source": "staging_synthetic", "notes": "采购价上涨后不补货"},
    {"id": "sc-002", "category": "restock_margin", "title": "批量采购降本后毛利恢复", "eval_mode": "deterministic", "input": {"revenue": "35.00", "product_cost": "14.00", "shipping_cost": "12.00", "payment_fee": "1.05"}, "expected": {"output_keys": ["contribution_margin_rate"], "rules": [{"type": "value_range", "key": "contribution_margin_rate", "min": 0.2, "max": 0.3}]}, "source": "staging_synthetic", "notes": "margin=7.95，rate≈0.227"},
    {"id": "sc-003", "category": "restock_margin", "title": "物流专线涨价吞噬毛利", "eval_mode": "deterministic", "input": {"revenue": "50.00", "product_cost": "15.00", "shipping_cost": "24.00", "payment_fee": "1.50"}, "expected": {"output_keys": ["contribution_margin"], "rules": [{"type": "value_lt", "key": "contribution_margin", "value": 10}]}, "source": "staging_synthetic", "notes": "运费占比 48%"},
    {"id": "sc-004", "category": "restock_margin", "title": "头程+尾程合并成本核算", "eval_mode": "deterministic", "input": {"revenue": "80.00", "product_cost": "20.00", "shipping_cost": "30.00", "payment_fee": "2.40", "advertising_cost": "5.00"}, "expected": {"output_keys": ["total_cost"], "rules": [{"type": "value_equal", "key": "total_cost", "value": 57.4}]}, "source": "staging_synthetic", "notes": "total_cost=20+30+2.4+5=57.4"},
    {"id": "sc-005", "category": "restock_margin", "title": "高退款率商品补货谨慎", "eval_mode": "deterministic", "input": {"revenue": "100.00", "product_cost": "30.00", "shipping_cost": "20.00", "refund": "35.00", "payment_fee": "3.00"}, "expected": {"output_keys": ["contribution_margin_rate"], "rules": [{"type": "value_lt", "key": "contribution_margin_rate", "value": 0.15}]}, "source": "staging_synthetic", "notes": "退款 35% 场景"},
    {"id": "sc-006", "category": "restock_margin", "title": "旺季运费上浮 20% 敏感性", "eval_mode": "deterministic", "input": {"revenue": "60.00", "product_cost": "18.00", "shipping_cost": "21.60", "payment_fee": "1.80"}, "expected": {"output_keys": ["contribution_margin_rate"], "rules": [{"type": "value_range", "key": "contribution_margin_rate", "min": 0.28, "max": 0.34}]}, "source": "staging_synthetic", "notes": "margin=18.6，rate=0.31"},
    {"id": "sc-007", "category": "restock_margin", "title": "零收入补货场景防御", "eval_mode": "deterministic", "input": {"revenue": "0", "product_cost": "10.00", "shipping_cost": "10.00"}, "expected": {"output_keys": ["contribution_margin_rate"], "rules": [{"type": "value_equal", "key": "contribution_margin_rate", "value": 0}]}, "source": "staging_synthetic", "notes": "无销量不触发补货建议"},
    {"id": "sc-008", "category": "restock_margin", "title": "广告成本高企补货需再评估", "eval_mode": "deterministic", "input": {"revenue": "70.00", "product_cost": "20.00", "shipping_cost": "18.00", "advertising_cost": "22.00", "payment_fee": "2.10"}, "expected": {"output_keys": ["contribution_margin"], "rules": [{"type": "value_lt", "key": "contribution_margin", "value": 8}]}, "source": "staging_synthetic", "notes": "margin=7.9，广告占比 31%"},
    {"id": "sc-009", "category": "restock_margin", "title": "高客单大件毛利核算", "eval_mode": "deterministic", "input": {"revenue": "220.00", "product_cost": "90.00", "shipping_cost": "70.00", "payment_fee": "6.60"}, "expected": {"output_keys": ["contribution_margin_rate"], "rules": [{"type": "value_range", "key": "contribution_margin_rate", "min": 0.2, "max": 0.3}]}, "source": "staging_synthetic", "notes": "margin=53.4，rate≈0.243"},
    {"id": "sc-010", "category": "restock_margin", "title": "跨境小包低运费场景", "eval_mode": "deterministic", "input": {"revenue": "25.00", "product_cost": "6.00", "shipping_cost": "5.00", "payment_fee": "0.75"}, "expected": {"output_keys": ["contribution_margin_rate"], "rules": [{"type": "value_range", "key": "contribution_margin_rate", "min": 0.5, "max": 0.6}]}, "source": "staging_synthetic", "notes": "margin=13.25，rate=0.53"},
    {"id": "sc-011", "category": "restock_margin", "title": "支付费+退款双重损耗", "eval_mode": "deterministic", "input": {"revenue": "45.00", "product_cost": "12.00", "shipping_cost": "11.00", "payment_fee": "1.35", "refund": "8.00"}, "expected": {"output_keys": ["total_cost"], "rules": [{"type": "value_equal", "key": "total_cost", "value": 32.35}]}, "source": "staging_synthetic", "notes": "total_cost=12+11+1.35+8=32.35"},
    {"id": "sc-012", "category": "restock_margin", "title": "低价引流品毛利必须为正", "eval_mode": "deterministic", "input": {"revenue": "19.99", "product_cost": "8.00", "shipping_cost": "6.00", "payment_fee": "0.60"}, "expected": {"output_keys": ["contribution_margin"], "rules": [{"type": "value_gt", "key": "contribution_margin", "value": 0}]}, "source": "staging_synthetic", "notes": "margin=5.39"},
    {"id": "sc-013", "category": "cost_confidence", "title": "供应商报价完整→HIGH", "eval_mode": "deterministic", "input": {"matched": 4, "total": 4}, "expected": {"output_keys": ["profit_confidence"], "rules": [{"type": "value_equal", "key": "profit_confidence", "value": "HIGH"}]}, "source": "staging_synthetic", "notes": "1688 报价全齐"},
    {"id": "sc-014", "category": "cost_confidence", "title": "运费未询价→MEDIUM", "eval_mode": "deterministic", "input": {"matched": 3, "total": 4}, "expected": {"output_keys": ["cost_status"], "rules": [{"type": "value_equal", "key": "cost_status", "value": "ESTIMATED"}]}, "source": "staging_synthetic", "notes": "缺尾程报价"},
    {"id": "sc-015", "category": "cost_confidence", "title": "新供应商无历史成本→LOW", "eval_mode": "deterministic", "input": {"matched": 0, "total": 3}, "expected": {"output_keys": ["profit_confidence"], "rules": [{"type": "value_equal", "key": "profit_confidence", "value": "LOW"}]}, "source": "staging_synthetic", "notes": "首单供应商不得下补货结论"},
    {"id": "sc-016", "category": "cost_confidence", "title": "部分供应商报价→MEDIUM 谨慎补货", "eval_mode": "deterministic", "input": {"matched": 2, "total": 5}, "expected": {"output_keys": ["cost_status"], "rules": [{"type": "value_equal", "key": "cost_status", "value": "ESTIMATED"}]}, "source": "staging_synthetic", "notes": "多渠道比价未完成"},
    {"id": "sc-017", "category": "cost_confidence", "title": "物流成本历史数据完整", "eval_mode": "deterministic", "input": {"matched": 6, "total": 6}, "expected": {"output_keys": ["profit_confidence"], "rules": [{"type": "value_equal", "key": "profit_confidence", "value": "HIGH"}]}, "source": "staging_synthetic", "notes": "物流历史完整可支持采购决策"},
    {"id": "sc-018", "category": "cost_confidence", "title": "汇率波动期成本置信度降级", "eval_mode": "deterministic", "input": {"matched": 4, "total": 5}, "expected": {"output_keys": ["cost_status"], "rules": [{"type": "value_equal", "key": "cost_status", "value": "ESTIMATED"}]}, "source": "staging_synthetic", "notes": "一项汇率估算即整体估算"},
    {"id": "sc-019", "category": "cost_confidence", "title": "空成本集防御", "eval_mode": "deterministic", "input": {"matched": 0, "total": 0}, "expected": {"output_keys": ["profit_confidence"], "rules": [{"type": "value_equal", "key": "profit_confidence", "value": "LOW"}]}, "source": "staging_synthetic", "notes": "无数据禁止结论"},
    {"id": "sc-020", "category": "cost_confidence", "title": "8/10 已知仍按估算处理", "eval_mode": "deterministic", "input": {"matched": 8, "total": 10}, "expected": {"output_keys": ["cost_status"], "rules": [{"type": "value_equal", "key": "cost_status", "value": "ESTIMATED"}]}, "source": "staging_synthetic", "notes": "缺口 2 项影响补货批量"},
    {"id": "sc-021", "category": "llm_procurement", "title": "1688 下单前必须核价", "eval_mode": "llm", "input": {"product_id": "p-1001", "supplier": "义乌户外用品厂", "price_cny": "85", "moq": 50, "lead_days": 7}, "expected": {"output_keys": ["verdict", "reason"], "rules": [{"type": "value_in", "key": "verdict", "values": ["approve", "reject", "needs_review"]}]}, "source": "staging_synthetic", "notes": "采购决策需真实推理"},
    {"id": "sc-022", "category": "llm_procurement", "title": "物流时效异常预警", "eval_mode": "llm", "input": {"tracking_no": "LP00123456789", "days_in_transit": 21, "expected_days": 15}, "expected": {"output_keys": ["alert_level"], "rules": [{"type": "value_in", "key": "alert_level", "values": ["high", "medium", "warning"]}]}, "source": "staging_synthetic", "notes": "超期 6 天应触发预警"},
    {"id": "sc-023", "category": "llm_procurement", "title": "供应商历史延迟记录决策参考", "eval_mode": "llm", "input": {"supplier": "广州仓储设备", "on_time_rate": 0.72, "avg_delay_days": 4.5}, "expected": {"output_keys": ["recommendation"], "rules": [{"type": "value_in", "key": "recommendation", "values": ["review", "replace", "caution", "risk"]}]}, "source": "staging_synthetic", "notes": "准时率 <80% 应提示风险"}
