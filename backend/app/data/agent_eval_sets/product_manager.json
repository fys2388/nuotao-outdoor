    {
      "id": "pm-010",
      "category": "profit_margin",
      "title": "零成本全未知场景禁用高置信结论",
      "eval_mode": "deterministic",
      "input": {
        "revenue": "70.00",
        "product_cost": "0",
        "shipping_cost": "0",
        "payment_fee": "0"
      },
      "expected": {
        "output_keys": [
          "contribution_margin_rate"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "contribution_margin_rate",
            "value": 1
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "无成本数据时 margin=revenue，rate=1 是计算事实，但报告必须标注 UNKNOWN 置信度（见 cost_confidence 用例）"
    },
    {
      "id": "pm-011",
      "category": "cost_confidence",
      "title": "全部成本已知→HIGH 置信度",
      "eval_mode": "deterministic",
      "input": {
        "matched": 5,
        "total": 5
      },
      "expected": {
        "output_keys": [
          "cost_status",
          "profit_confidence"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "cost_status",
            "value": "KNOWN"
          },
          {
            "type": "value_equal",
            "key": "profit_confidence",
            "value": "HIGH"
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "matched==total 必须 HIGH"
    },
    {
      "id": "pm-012",
      "category": "cost_confidence",
      "title": "部分成本已知→MEDIUM 且必须标注估算",
      "eval_mode": "deterministic",
      "input": {
        "matched": 3,
        "total": 5
      },
      "expected": {
        "output_keys": [
          "cost_status",
          "profit_confidence"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "cost_status",
            "value": "ESTIMATED"
          },
          {
            "type": "value_equal",
            "key": "profit_confidence",
            "value": "MEDIUM"
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "部分未知禁止 HIGH"
    },
