      "input": {
        "revenue": "100.00",
        "product_cost": "30.00",
        "shipping_cost": "20.00",
        "advertising_cost": "25.00",
        "payment_fee": "3.00"
      },
      "expected": {
        "output_keys": [
          "total_cost"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "total_cost",
            "value": 78
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "total_cost = 30+20+25+3 = 78"
    },
    {
      "id": "pm-006",
      "category": "profit_margin",
      "title": "目标净利率 15% 达标场景",
