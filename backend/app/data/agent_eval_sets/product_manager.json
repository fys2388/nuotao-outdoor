{
  "agent_id": "product_manager",
  "description": "产品经理 Agent 评测集：选品成本核算与成本置信度判定（确定性用例，基于 profit_engine）",
  "cases": [
    {
      "id": "pm-001",
      "category": "profit_margin",
      "title": "高运费场景毛利为负",
      "eval_mode": "deterministic",
      "input": {
        "revenue": "60.00",
        "product_cost": "15.00",
        "shipping_cost": "28.00",
        "payment_fee": "1.80",
        "refund": "20.00"
      },
      "expected": {
        "output_keys": [
          "contribution_margin",
          "contribution_margin_rate"
        ],
        "rules": [
          {
            "type": "key_exists",
            "key": "contribution_margin"
          },
          {
            "type": "value_lt",
            "key": "contribution_margin",
            "value": 0
          },
          {
            "type": "key_exists",
            "key": "contribution_margin_rate"
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "运费占比 46.7% + 高退款，应判负毛利，不得推荐上架"
    },
    {
      "id": "pm-002",
      "category": "profit_margin",
      "title": "轻小件高毛利场景",
      "eval_mode": "deterministic",
      "input": {
        "revenue": "45.00",
        "product_cost": "8.00",
        "shipping_cost": "10.00",
        "payment_fee": "1.35"
      },
      "expected": {
        "output_keys": [
          "contribution_margin_rate"
        ],
        "rules": [
          {
            "type": "value_range",
            "key": "contribution_margin_rate",
            "min": 0.4,
            "max": 1.0
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "轻小件运费占比低，毛利应健康"
    },
    {
      "id": "pm-003",
      "category": "profit_margin",
      "title": "零收入输入必须返回 0 利润率",
      "eval_mode": "deterministic",
      "input": {
        "revenue": "0",
        "product_cost": "10.00",
        "shipping_cost": "5.00"
      },
      "expected": {
        "output_keys": [
          "contribution_margin_rate"
        ],
        "rules": [
          {
            "type": "value_equal",
            "key": "contribution_margin_rate",
            "value": 0
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "revenue=0 时 rate 必须为 0，禁止除零"
    },
    {
      "id": "pm-004",
      "category": "profit_margin",
      "title": "退款损耗吞噬利润",
      "eval_mode": "deterministic",
      "input": {
        "revenue": "80.00",
        "product_cost": "20.00",
        "shipping_cost": "15.00",
        "payment_fee": "2.40",
        "refund": "25.00"
      },
      "expected": {
        "output_keys": [
          "contribution_margin"
        ],
        "rules": [
          {
            "type": "value_lt",
            "key": "contribution_margin",
            "value": 20
          }
        ]
      },
      "source": "staging_synthetic",
      "notes": "退款占比 31%，利润大幅侵蚀"
    },
    {
      "id": "pm-005",
      "category": "profit_margin",
      "title": "广告成本计入总成本",
