# ============================================================
# Nuotao AI OS — environment template
# Copy to .env and adjust values. Never commit real secrets.
# ============================================================

# Application
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose and local tooling)
POSTGRES_USER=nuotao
POSTGRES_PASSWORD=nuotao_dev_password
POSTGRES_DB=nuotao
POSTGRES_PORT=5432

# Backend service
# Local development URL (host is localhost); docker-compose overrides the host.
DATABASE_URL=postgresql+asyncpg://nuotao:nuotao_dev_password@localhost:5432/nuotao
REDIS_URL=redis://localhost:6379/0
BACKEND_PORT=8000
REDIS_PORT=6379