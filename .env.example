# ============================================================
# Nuotao AI OS — environment template
# Copy to .env and adjust values. Never commit real secrets.
# ============================================================

# Application
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# JWT signing key — REQUIRED in production.
# 2026-10-11 incident: a hardcoded dev key was committed to a public repo and
# allowed forging admin tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# PostgreSQL (used by docker-compose and local tooling)
POSTGRES_USER=nuotao
POSTGRES_PASSWORD=REDACTED_DEFAULT_DB
POSTGRES_DB=nuotao
POSTGRES_PORT=5432

# Monitoring stack (infra/deploy_monitoring.sh reads these)
GRAFANA_ADMIN_PASSWORD=

# Backend service
# Local development URL (host is localhost); docker-compose overrides the host.
DATABASE_URL=postgresql+asyncpg://nuotao:REDACTED_DEFAULT_DB@localhost:5432/nuotao
REDIS_URL=redis://localhost:6379/0

# WooCommerce integration (WC REST API v3 + WordPress REST API v2)
# Credentials go ONLY in the local .env — never in code, docs, or commits.
# 2026-10-11 incident: hardcoded values in this template's absence led to
# real keys being pasted into ~40 scripts and one SOP doc.
# Create keys in: WP Admin → Settings → Advanced → REST API  (prefer Read-only)
# WP app password: WP Admin → Users → Profile → Application Passwords
WOOCOMMERCE_BASE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
WOOCOMMERCE_WEBHOOK_SECRET=dev-webhook-secret-change-me
# WordPress app password is required for /wp-json/wp/v2/media (the WC
# consumer key is NOT accepted there).
WP_USERNAME=
WP_APP_PASSWORD=
PAYMENT_FEE_RATE=0.029
PAYMENT_FEE_FIXED=0.30
BACKEND_PORT=8000
REDIS_PORT=6379

# LLM Gateway (M2.2): multi-provider, OpenAI primary / DeepSeek fallback.
# Leave keys empty in development; agents still run against mocks in tests.
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
# ============================================================
# M5.5 Agent Platform Productionization
# ============================================================

# Worker (horizontal scaling): each worker process claims its own messages.
# AGENT_WORKER_ID must be unique per container when scaling; leave empty to
# auto-generate worker-{hostname}-{pid}.
AGENT_WORKER_ID=
AGENT_WORKER_CONCURRENCY=4

# Alert Scheduler (resident loop that runs evaluate_alerts()).
AGENT_ALERT_SCHEDULER_ENABLED=true
AGENT_ALERT_INTERVAL_SECONDS=60
# Optional scope filters (comma separated); empty = all workspaces/agents.
ALERT_WORKSPACE_IDS=
ALERT_AGENT_IDS=

# Approval Center RBAC (server-side permission checks; 403 when missing).
APPROVAL_RBAC_ENABLED=true
# Approval SLA defaults (seconds): pending -> warning -> expired.
APPROVAL_SLA_ENABLED=true
APPROVAL_DEFAULT_WARNING_SECONDS=3600
APPROVAL_DEFAULT_EXPIRE_SECONDS=86400

# Actor identity (M5.8/M5.14). AUTHENTICATION_GAP: with ACTOR_PROVIDER=body
# the actor is declared in the request body (staging-safe, RBAC still enforced
# server-side). With ACTOR_PROVIDER=header the actor MUST come from a
# cryptographically verified RS256 JWT (Clerk) carried in the trusted
# identity header injected by Cloudflare Access / a trusted proxy - request
# body actors and raw X-Actor values are never accepted.
ACTOR_PROVIDER=body
# Legacy seam, unused in header mode.
ACTOR_HEADER_NAME=X-Actor
# M5.14 Identity Foundation (STAGING ONLY): trusted identity header + Clerk
# JWKS. Empty values fail closed (401) - no fallback to the body actor.
# Configure with real Clerk Test Instance values in staging.
TRUSTED_IDENTITY_HEADER=CF-Access-Jwt-Assertion
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
JWT_CLOCK_SKEW_SECONDS=30
JWKS_CACHE_TTL_SECONDS=300
JWKS_FETCH_TIMEOUT_SECONDS=5

# ============================================================
# M6 Image Generation (pluggable gateway, cost-guarded)
# ============================================================
# Default model: wan2.7-image (Alibaba DashScope, ¥0.08/img)
# Leave keys empty in development; the mock backend returns placeholders.
IMAGE_GEN_DEFAULT_MODEL=wan2.7-image
IMAGE_GEN_MONTHLY_BUDGET_CNY=100.00
IMAGE_GEN_HIGH_COST_THRESHOLD_CNY=0.15
IMAGE_GEN_STORAGE_DIR=data/generated_images

# Alibaba Cloud DashScope (wan2.7-image / qwen-image-3.0)
DASHSCOPE_API_KEY=

# Volcengine Ark (seedream-4.0)
VOLCENGINE_API_KEY=
VOLCENGINE_ARK_ENDPOINT=

# Agnes AI image generation (agnes-image-2.5-flash)
# 2026-10-11 incident: a live key was hardcoded in ~24 scripts and one SOP doc.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ============================================================
# Email / SMTP (Brevo relay)
# ============================================================
# Brevo SMTP relay keys start with "xsmtpsib-". 2026-10-11 incident: one was
# hardcoded in backend/test-smtp-auth.py and has been revoked.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=b7a6aa001@smtp-brevo.com
BREVO_SMTP_KEY=

# Server SSH password (used by ops scripts such as fix_*.py)
SERVER_SSH_PASSWORD=

# SenseNova API (LLM gateway)
SENSENOVA_API_KEY=

# ============================================================
# Never commit real secrets. Before pushing, run:
#   ggshield secret scan repo          (or: trufflehog git file://. --since-commit 1970)
# ============================================================

