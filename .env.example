# ============================================================
# Nuotao AI OS — environment template
# Copy to .env and adjust values. Never commit real secrets.
# ============================================================

# Application
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose and local tooling)
POSTGRES_USER=nuotao
POSTGRES_PASSWORD=nuotao_dev_password
POSTGRES_DB=nuotao
POSTGRES_PORT=5432

# Backend service
# Local development URL (host is localhost); docker-compose overrides the host.
DATABASE_URL=postgresql+asyncpg://nuotao:nuotao_dev_password@localhost:5432/nuotao
REDIS_URL=redis://localhost:6379/0
WOOCOMMERCE_WEBHOOK_SECRET=dev-webhook-secret-change-me
PAYMENT_FEE_RATE=0.029
PAYMENT_FEE_FIXED=0.30
BACKEND_PORT=8000
REDIS_PORT=6379

# LLM Gateway (M2.2): multi-provider, OpenAI primary / DeepSeek fallback.
# Leave keys empty in development; agents still run against mocks in tests.
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
# ============================================================
# M5.5 Agent Platform Productionization
# ============================================================

# Worker (horizontal scaling): each worker process claims its own messages.
# AGENT_WORKER_ID must be unique per container when scaling; leave empty to
# auto-generate worker-{hostname}-{pid}.
AGENT_WORKER_ID=
AGENT_WORKER_CONCURRENCY=4

# Alert Scheduler (resident loop that runs evaluate_alerts()).
AGENT_ALERT_SCHEDULER_ENABLED=true
AGENT_ALERT_INTERVAL_SECONDS=60
# Optional scope filters (comma separated); empty = all workspaces/agents.
ALERT_WORKSPACE_IDS=
ALERT_AGENT_IDS=

# Approval Center RBAC (server-side permission checks; 403 when missing).
APPROVAL_RBAC_ENABLED=true
# Approval SLA defaults (seconds): pending -> warning -> expired.
APPROVAL_SLA_ENABLED=true
APPROVAL_DEFAULT_WARNING_SECONDS=3600
APPROVAL_DEFAULT_EXPIRE_SECONDS=86400
